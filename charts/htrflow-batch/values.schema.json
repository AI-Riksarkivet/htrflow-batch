{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "htrflow-batch values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "s3",
    "publicResultsBase",
    "legacyLayout",
    "modelCache",
    "queue",
    "api",
    "security",
    "network",
    "viewer"
  ],
  "definitions": {
    "cidr": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
    },
    "cidrList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/cidr"
      }
    },
    "nodePort": {
      "type": "integer",
      "minimum": 30000,
      "maximum": 32767
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E|m)?$"
    },
    "imageRef": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/stringMap"
        },
        "limits": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "existingSecret"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicResultsBase": {
      "type": "string",
      "pattern": "^(https?://.+)?$"
    },
    "legacyLayout": {
      "type": "boolean"
    },
    "modelCache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "size",
        "storageClass",
        "accessModes"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "$ref": "#/definitions/quantity"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "flavor",
        "resources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "flavor": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "quota"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "quota": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "#/definitions/quantity"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/imageRef"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedImageRepos",
        "requireModelRevision",
        "psaEnforce",
        "allowTagImages",
        "verifyImages"
      ],
      "properties": {
        "allowedImageRepos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requireModelRevision": {
          "type": "boolean"
        },
        "psaEnforce": {
          "type": "string",
          "enum": [
            "baseline",
            "restricted"
          ]
        },
        "allowTagImages": {
          "type": "boolean"
        },
        "verifyImages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "issuer",
            "subject",
            "imageReferences",
            "rekorUrl"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuer": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "imageReferences": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rekorUrl": {
              "type": "string",
              "pattern": "^https://.+"
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "defaultDeny",
        "iiifCidrs",
        "s3Cidrs",
        "clusterCidrs",
        "nodeCidrs",
        "apiServer",
        "viewer"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaultDeny": {
          "type": "boolean"
        },
        "iiifCidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "s3Cidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "clusterCidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "nodeCidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "apiServer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr",
            "port"
          ],
          "properties": {
            "cidr": {
              "oneOf": [
                {
                  "$ref": "#/definitions/cidr"
                },
                {
                  "type": "string",
                  "maxLength": 0
                }
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "viewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingressCidrs"
          ],
          "properties": {
            "ingressCidrs": {
              "$ref": "#/definitions/cidrList"
            }
          }
        }
      }
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "nodePort",
        "defaultManifest",
        "securityHeaders"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/imageRef"
        },
        "nodePort": {
          "$ref": "#/definitions/nodePort"
        },
        "defaultManifest": {
          "type": "string"
        },
        "securityHeaders": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
