{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "htrflow-batch values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "s3",
    "hfToken",
    "publicResultsBase",
    "modelCache",
    "queue",
    "web",
    "apply",
    "security",
    "network"
  ],
  "definitions": {
    "cidr": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])$"
    },
    "cidrList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/cidr"
      }
    },
    "nodePort": {
      "type": "integer",
      "minimum": 30000,
      "maximum": 32767
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E|m)?$"
    },
    "imageRef": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/stringMap"
        },
        "limits": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceSelector": {
          "$ref": "#/definitions/labelSelector"
        },
        "podSelector": {
          "$ref": "#/definitions/labelSelector"
        }
      }
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hfToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "maxLength": 253
        }
      }
    },
    "publicResultsBase": {
      "type": "string",
      "pattern": "^(https?://.+)?$"
    },
    "modelCache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "size",
        "storageClass",
        "accessModes"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "$ref": "#/definitions/quantity"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "flavor",
        "resources",
        "createFlavor",
        "clusterQueueName",
        "createClusterQueue",
        "createPriorityClasses"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "flavor": {
          "type": "string",
          "minLength": 1
        },
        "createFlavor": {
          "type": "boolean"
        },
        "clusterQueueName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "createClusterQueue": {
          "type": "boolean"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "quota"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "quota": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "#/definitions/quantity"
                  }
                ]
              }
            }
          }
        },
        "flavors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "nodeLabels",
              "quota"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "nodeLabels": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 8,
                "additionalProperties": {
                  "type": "string"
                }
              },
              "nodeTaints": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "effect"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "effect": {
                      "enum": [
                        "NoSchedule",
                        "PreferNoSchedule",
                        "NoExecute"
                      ]
                    }
                  }
                }
              },
              "quota": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cpu",
                  "memory",
                  "nvidia.com/gpu"
                ],
                "properties": {
                  "cpu": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "$ref": "#/definitions/quantity"
                      }
                    ]
                  },
                  "memory": {
                    "$ref": "#/definitions/quantity"
                  },
                  "nvidia.com/gpu": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "createPriorityClasses": {
          "type": "boolean"
        },
        "priorityClasses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "value": {
                "type": "integer"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "nodePort",
        "resources",
        "service",
        "ingress"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/imageRef"
        },
        "nodePort": {
          "$ref": "#/definitions/nodePort"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "internalResultsBase": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "NodePort",
                "ClusterIP"
              ]
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "className",
            "host",
            "tlsSecretName",
            "annotations"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "tlsSecretName": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rbac",
        "gitCidrs",
        "gitPorts"
      ],
      "properties": {
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "gitCidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "gitPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedImageRepos",
        "jobImageRepos",
        "requireModelRevision",
        "policies",
        "psaEnforce",
        "allowTagImages",
        "verifyImages"
      ],
      "properties": {
        "allowedImageRepos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "jobImageRepos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requireModelRevision": {
          "type": "boolean"
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowDisabled": {
              "type": "boolean"
            }
          }
        },
        "psaEnforce": {
          "type": "string",
          "enum": [
            "baseline",
            "restricted"
          ]
        },
        "allowTagImages": {
          "type": "boolean"
        },
        "verifyImages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "issuer",
            "subject",
            "imageReferences",
            "rekorUrl"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuer": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "imageReferences": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rekorUrl": {
              "type": "string",
              "pattern": "^https://.+"
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "defaultDeny",
        "iiifCidrs",
        "s3Cidrs",
        "s3InNamespace",
        "s3Ports",
        "clusterCidrs",
        "privateCidrs",
        "nodeCidrs",
        "apiServer",
        "web"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaultDeny": {
          "type": "boolean"
        },
        "iiifCidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "s3Cidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "s3InNamespace": {
          "type": "boolean"
        },
        "s3Ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "clusterCidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "privateCidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "nodeCidrs": {
          "$ref": "#/definitions/cidrList"
        },
        "apiServer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr",
            "cidrs",
            "port"
          ],
          "properties": {
            "cidr": {
              "oneOf": [
                {
                  "$ref": "#/definitions/cidr"
                },
                {
                  "type": "string",
                  "maxLength": 0
                }
              ]
            },
            "cidrs": {
              "$ref": "#/definitions/cidrList"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingressCidrs",
            "allowPublicIngress",
            "ingressFrom"
          ],
          "properties": {
            "ingressCidrs": {
              "$ref": "#/definitions/cidrList"
            },
            "allowPublicIngress": {
              "type": "boolean"
            },
            "ingressFrom": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/networkPolicyPeer"
              }
            }
          }
        }
      }
    }
  }
}
