# Exceptions to scripts/docs_lint.py: path-suffix<TAB>regex, one per line.
# A hit is allowed when its file path ends with the suffix and the line
# matches the regex. Every entry says why it is not a leak of one site.

# The compose smoke stack runs on the reader's own machine.
getting-started/try-it.md	localhost

# Code defaults that still name one institution's IIIF source and address
# (converter source_template, chart network.iiifCidrs). Remove these two
# entries when the defaults are made neutral in code.
reference/configuration.md	arkis!\{ref\}|192\.121\.221\.27/32
reference/chart.md	192\.121\.221\.27/32

# The S3 bucket-policy language version is a fixed string, not a date.
.md	"Version": "2012-10-17"

# A real Makefile target whose name carries an architecture (renaming it is
# a code change). Remove when the target is renamed.
development/dev-cluster.md	make build-htrflow-base-arm64 
