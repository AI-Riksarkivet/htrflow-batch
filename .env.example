# Cluster-local constants for the Makefile and .docker/docker-compose.yml.
# Copy to `.env` (git-ignored) and adjust; every value has the PoC default
# shown here, so a missing `.env` behaves exactly like this file.
#
# These are the ONLY places the PoC's registry/S3/namespace strings live on
# the ops side; the chart takes the same values via `--set`/values files and
# the Python packages take them from their own env (see docs reference).

# Helm release and namespace of the platform.
HTR_RELEASE=htr
HTR_NAMESPACE=htr-batch

# In-cluster PoC registry (devStack.registry): host-side push address and the
# NodePort it maps to. containerd pulls 127.0.0.1:<port> without TLS.
HTR_REGISTRY=127.0.0.1:30500
HTR_REGISTRY_NODEPORT=30500

# devStack RustFS S3 as seen from the host (SSH-forwarded NodePort) and the
# results bucket the platform writes to (chart value s3.bucket).
HTR_S3_ENDPOINT=http://localhost:30900
HTR_S3_NODEPORT=30900
HTR_BUCKET=htr-results

# Web front NodePort (chart value web.nodePort).
HTR_WEB_NODEPORT=30800

# Model cache PVC (chart value modelCache.name) — used by `make warmup`.
HTR_DATA_PVC=htr-test-data

# Local checkout of Riksarkivet/htrflow: the arm64 GPU wrapper is built FROM
# a base image built there, and its `git describe` is stamped into the image
# (HTRFLOW_BASE_REVISION build arg) so manifest.json provenance is honest.
HTRFLOW_DIR=~/htrflow

# Local compose smoke stack only (.docker/docker-compose.yml): throwaway
# RustFS root credentials. Never reuse for a cluster.
HTR_DEV_S3_ACCESS_KEY=rustfsadmin
HTR_DEV_S3_SECRET_KEY=rustfsadmin
