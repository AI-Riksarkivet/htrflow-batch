# The transformers the wrapper image runs: what it installs on top of the
# base, compiled with hashes into transformers.txt (`make
# transformers-requirements`) and installed with --no-deps --require-hashes.
# Only these packages move; their other dependencies are the base's and the
# wrapper's, and the image build checks that those satisfy them.
# huggingface-hub is here because this transformers needs its 1.x major,
# tokenizers because the base's may be older than this transformers accepts;
# protobuf and sentencepiece because transformers needs them to load and
# convert slow tokenizers.
transformers==5.9.0
huggingface-hub==1.32.0
protobuf==7.36.1
tokenizers==0.22.2
sentencepiece==0.2.2 ; platform_machine == 'aarch64'
