 import { AnnotationRect } from "@iiif/manifold";
 import { OpenSeadragonExtensionEvents } from "../../extensions/uv-openseadragon-extension/Events";
 
+const SVG_NS = "http://www.w3.org/2000/svg";
+const PLAIN_NUMBER = /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/;
+
+function childNamed(parent: Element, name: string): Element | null {
+  const kids = parent.children;
+  for (let i = 0; i < kids.length; i++) {
+    if (kids[i].localName === name) {
+      return kids[i];
+    }
+  }
+  return null;
+}
+
+// A TextLine's outline, TextLine/Shape/Polygon@POINTS as htrflow writes it
+// ("x1,y1 x2,y2 ...", or ALTO's plain "x1 y1 x2 y2 ..."): absolute page
+// pixels, the space HPOS/VPOS are in. Returns the flat coordinate list, or
+// null when the line has none or it is no usable polygon -- an odd count,
+// fewer than three points, or any token that is not a plain finite number.
+function parseAltoPolygon(textLine: Element): number[] | null {
+  const shape = childNamed(textLine, "Shape");
+  const polygon = shape ? childNamed(shape, "Polygon") : null;
+  const raw = polygon ? polygon.getAttribute("POINTS") : null;
+  if (!raw) {
+    return null;
+  }
+  const tokens = raw.trim().split(/[\s,]+/);
+  if (tokens.length % 2 !== 0 || tokens.length < 6) {
+    return null;
+  }
+  const coords: number[] = [];
+  for (let i = 0; i < tokens.length; i++) {
+    const n = PLAIN_NUMBER.test(tokens[i]) ? Number(tokens[i]) : NaN;
+    if (!Number.isFinite(n)) {
+      return null;
+    }
+    coords.push(n);
+  }
+  return coords;
+}
